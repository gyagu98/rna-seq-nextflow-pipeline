/*
========================================================================================
   rna-seq-nextflow-pipeline config
========================================================================================
*/

params {
    input                  = null
    transcriptome          = null
    outdir                 = 'results'
    help                   = false
    salmon_kmer            = 21
    max_cpus               = 4
    max_memory             = '8.GB'
    max_time               = '4.h'
}

manifest {
    name            = 'gyagu98/rna-seq-nextflow-pipeline'
    author          = 'Gretta Y. Rozenberg'
    homePage        = 'https://github.com/gyagu98/rna-seq-nextflow-pipeline'
    description     = 'Portable RNA-seq pipeline with FastQC, Salmon quantification, MultiQC, and DESeq2'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.1'
    version         = '1.0.0'
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled       = true
        docker.userEmulation  = true
        singularity.enabled  = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'
